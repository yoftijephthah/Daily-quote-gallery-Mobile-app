<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <!-- Theme Toggle -->
    <ImageButton
        android:id="@+id/btnToggleThemeDetail"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Toggle Theme"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_moon"
        app:tint="?android:attr/textColorPrimary" />

    <!-- 1. FULL IMAGE -->
    <ImageView
        android:id="@+id/fullImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/buttonCard"
        android:contentDescription="@string/desc_full_image"
        android:padding="24dp"
        android:scaleType="fitCenter" />

    <!-- 2. MODERN FLOATING BUTTON BAR -->
    <androidx.cardview.widget.CardView
        android:id="@+id/buttonCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="?android:attr/windowBackground"
        app:strokeColor="?android:attr/textColorPrimary"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btnDownload"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_download"
                android:src="@drawable/ic_download"
                app:tint="?android:attr/textColorPrimary" />

            <ImageButton
                android:id="@+id/btnFb"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_facebook"
                android:src="@drawable/ic_facebook"
                app:tint="?android:attr/textColorPrimary" />

            <ImageButton
                android:id="@+id/btnIg"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_instagram"
                android:src="@drawable/ic_instagram"
                app:tint="?android:attr/textColorPrimary" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_share"
                android:src="@drawable/ic_share"
                app:tint="?android:attr/textColorPrimary" />

            <ImageButton
                android:id="@+id/btnFavoriteDetail"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Favorite"
                android:src="@android:drawable/btn_star_big_off"
                app:tint="?android:attr/textColorPrimary" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
